{
  "name": "technohab",
  "version": "3.3.0-alpha.1",
  "description": "Générateur procédural de plans de principe 2D sous contraintes, exécuté entièrement dans le navigateur — aucune dépendance d'exécution, aucune transmission de données.",
  "license": "AGPL-3.0-or-later",
  "author": "Dargos (https://github.com/HolaHombre)",
  "homepage": "https://technohab.theoseguret.fr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HolaHombre/technohab-2d.git"
  },
  "bugs": {
    "url": "https://github.com/HolaHombre/technohab-2d/issues"
  },
  "keywords": [
    "procedural-generation",
    "floor-plan",
    "floor-plan-generator",
    "architecture",
    "space-planning",
    "generative-design",
    "constraint-solving",
    "housing",
    "local-first",
    "offline-first",
    "privacy",
    "no-cloud",
    "browser-based",
    "javascript",
    "canvas"
  ],
  "private": true,
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "public:build": "node scripts/build-public.mjs",
    "deploy": "npm run public:build && npx wrangler deploy",
    "serve:test": "node scripts/test-serve.mjs",
    "fit:build": "node scripts/build-envelopes.mjs",
    "fit:test": "node scripts/test-placement.mjs",
    "fit:check": "node scripts/test-definition-pieces.mjs",
    "technohab:validate": "node scripts/validate-m0.mjs",
    "technohab:audit-circulation": "node scripts/audit-circulation-mobilier.mjs",
    "icons:inline": "node scripts/inline-sprite.mjs",
    "icons:check": "node scripts/inline-sprite.mjs --check",
    "icons:audit": "node scripts/audit-icons.mjs",
    "icons:archlang": "npx --yes tsx scripts/archlang-sprite.mts && node scripts/inline-sprite.mjs",
    "test:analysis": "node scripts/test-analysis-export-ui.mjs",
    "catalogue:check": "node scripts/test-catalogue-mobilier.mjs && node scripts/test-catalog-ui.mjs"
  }
}
